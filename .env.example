# Travelpayouts API token (covers Aviasales flights + Hotellook hotels)
TP_TOKEN=your_travelpayouts_token

# Telegram
TG_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_chat_id

# Optional tuning (defaults shown)
ORIGINS=VIE,BTS
SCAN_WEEKENDS=8
TRIP_NIGHTS=3,4
TOTAL_THRESHOLD_EUR=250
ROLLING_DROP_PCT=0.25
HOTEL_SPLIT=1
DRY_RUN=false

# Coverage floors are fractions, not percents (0.10 = 10% of destinations).
# Below MIN_COVERAGE, or when transport errors exceed MAX_TRANSPORT_ERROR_RATE,
# the run fails and leaves deals.json untouched.
# Between MIN_COVERAGE and PARTIAL_COVERAGE the run stays green, writes
# deals.json, and sends a digest that says the board is partial.
MIN_COVERAGE=0.10
PARTIAL_COVERAGE=0.50
MAX_TRANSPORT_ERROR_RATE=0.25

# Parallel flight lookups. Lower MAX_WORKERS or set PACE_SECONDS (pause after
# each lookup, per worker) if rate-limit retries climb. A full scan at the
# default stays well inside the 70-minute job timeout.
MAX_WORKERS=6
PACE_SECONDS=0
